# ==============================================================================
# Version constraints for amazon.aws collection testing
#
# STRATEGY: Test against MINIMUM supported versions to ensure compatibility
# This file is referenced by other .in files via `-c constraints.in`
# DO NOT compile this file - it's used as a constraint file, not requirements
# ==============================================================================

# Core AWS SDK Requirements
# --------------------------
# Bumped to 1.38.23 to support aiobotocore requirements
botocore==1.38.23
boto3==1.38.23

# Event-Driven Automation (EDA) Support
# --------------------------------------
# aiobotocore has very specific botocore requirements and rarely supports a.b.0
# Version 2.23.0 is compatible with botocore 1.38.23
# Required for EDA event source plugins
aiobotocore==2.23.0

# AWS CLI Compatibility
# ---------------------
# AWS CLI has `botocore==` dependencies
# Pin to matching version to avoid downloading years of awscli wheels
# awscli 1.40.22 is compatible with botocore 1.38.23
awscli==1.40.22
